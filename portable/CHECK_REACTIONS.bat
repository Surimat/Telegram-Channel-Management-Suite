@echo off
REM ============================================================
REM  Проверка реакций на посты канала (D-130).
REM
REM  Просто дважды щёлкните по этому файлу. Запускается встроенная
REM  диагностика встроенным Python — устанавливать ничего не нужно,
REM  вводить команды не нужно.
REM
REM  Проверка безопасна: она ничего не меняет, не выходит в интернет
REM  и НЕ отправляет реакции в настоящий Telegram. Используется
REM  встроенный тестовый «двойник» Telegram.
REM
REM  В конце будет понятный итог: что проверено, что работает,
REM  что сломано и какова причина.
REM ============================================================
setlocal enableextensions
cd /d "%~dp0"

REM Русские буквы в окне консоли.
chcp 65001 >nul

REM Код программы лежит в папке app\ ; делаем его видимым для Python.
set "PYTHONPATH=%~dp0app"

REM Берём встроенный Python из сборки; если его нет — системный.
set "PYTHON=%~dp0runtime\python.exe"
if not exist "%PYTHON%" set "PYTHON=python"

echo ============================================================
echo  Проверка реакций на посты канала
echo ============================================================
echo.
"%PYTHON%" "%~dp0app\scripts\check_reactions.py"

echo.
echo ============================================================
echo  Проверка завершена. Итог — в строке "ИТОГ:" выше.
echo  Если написано "ПРОЙДЕНО" — исправление работает.
echo  Это окно можно закрыть.
echo ============================================================
pause
endlocal
