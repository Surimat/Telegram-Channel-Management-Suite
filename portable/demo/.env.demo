# ============================================================
# Telegram Channel Management Suite - DEMO settings
#
# This file belongs to the demo\ folder. It runs the program in
# "demo" mode with ready-made test data and NO real Telegram
# connection. Copy of .env.demo -> .env happens automatically on
# the first run of DEMO_run.bat.
#
# Do NOT put real tokens or account data here.
# ============================================================

# --- Application ---
APP_ENV=demo
APP_HOST=127.0.0.1
# A separate port, so the demo never clashes with a real install.
APP_PORT=8010
STARTUP_TIMEOUT=45
STARTUP_POLL_MS=400
APP_DEBUG=false
APP_LANGUAGE=ru

# --- Security ---
# Demo-only key. This is a throwaway value and grants no access anywhere.
APP_SECRET_KEY=demo-only-not-a-secret-please-replace-in-a-real-install
APP_CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010

# --- Database (inside this demo folder) ---
DATABASE_URL=sqlite+aiosqlite:///./data/demo.db

# --- Telegram (offline: no real connection, no credentials) ---
# "fake" provider + offline mode: nothing leaves this computer.
OFFLINE_MODE=true
TELEGRAM_PROVIDER=fake
MANAGER_BOT_TOKEN=
MANAGER_BOT_ADMIN_IDS=
MANAGER_BOT_WEBHOOK_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSIONS_DIR=./sessions

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- Manager bot runtime (disabled in the demo) ---
MANAGER_RUNTIME_ENABLED=false

# --- Safety switches (all off in the demo) ---
# The demo never touches a real account and never sends anything.
PERSONAL_ACCOUNT_ENABLED=false
INVITES_ENABLED=false
AUTO_UPDATE_ENABLED=false

# --- LAN Mesh (off: the demo runs alone) ---
MESH_ENABLED=false
MESH_MODE=standalone

# --- Tiny AI classifier (off by default) ---
AI_ENABLED=false
AI_BACKEND=fake
AI_ENCODER_ENABLED=true
AI_ENCODER_MODEL_ENABLED=false
MODELS_DIR=./models

# --- Telegram Mini App (off) ---
MINIAPP_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION=20
BACKUP_INCLUDE_SESSIONS=false
