# ============================================================
# Telegram Channel Management Suite - .gitignore
# NEVER commit secrets, sessions, databases or runtime data.
# ============================================================

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.secret
secrets/
credentials.json
*.pem
*.key

# --- Telegram session files (MTProto) ---
sessions/*
!sessions/.gitkeep
*.session
*.session-journal
*.session.backup

# --- Runtime mutable data ---
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep
updates/*
!updates/.gitkeep
exports/*
!exports/.gitkeep
logs/*
!logs/.gitkeep
*.log
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --- Type checking / linting caches ---
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Built SPA output (reproducible: cd frontend && npm run build) ---
backend/app/static/*
!backend/app/static/.gitkeep

# --- Portable runtime (downloaded/embedded) ---
portable/runtime/
portable/app/
portable/build/
runtime/
# Portable release archives (built by scripts/build_portable.sh).
Telegram-Channel-Management-Suite-Windows-Portable-*.zip
Telegram-Channel-Management-Suite-Windows-Portable-*.zip.sha256

# --- AI models (large binaries) ---
# Only ignore a top-level models/ directory, never source packages.
/models/
*.gguf
*.ggml
*.bin
*.onnx

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Agent local temp ---
.agent_tmp/
