# ============================================================
# Telegram Channel Management Suite - Example environment file
# Copy to .env and fill in your own values.
# NEVER commit the real .env file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
# Locale used by the UI. RU-first.
APP_LANGUAGE=ru

# --- Security ---
# 32+ char random string used to sign local sessions / encrypt secrets.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-please-generate-a-long-random-value
# Comma separated list of allowed CORS origins (usually only local UI).
APP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Database ---
# Default SQLite file lives inside data/ (outside git).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Telegram Manager Bot ---
# Token from @BotFather. Leave empty until Setup Wizard is used.
MANAGER_BOT_TOKEN=
# Telegram numeric user id(s) allowed to control the manager bot.
MANAGER_BOT_ADMIN_IDS=
# Public URL used for Mini App / webhook on VPS. Empty for local mode.
MANAGER_BOT_WEBHOOK_URL=

# --- Telegram API (user accounts / MTProto) ---
# From https://my.telegram.org . Never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Session storage ---
# Directory for .session files. Must stay outside git and out of images.
SESSIONS_DIR=./sessions

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- Manager bot runtime (post-1.0 hardening) ---
# Poll the manager bot for commands / forward notifications while the app runs.
MANAGER_RUNTIME_ENABLED=true
# Seconds between manager-bot short polls (keeps CPU low).
MANAGER_RUNTIME_POLL_INTERVAL=3

# --- Tiny AI classifier (PHASE 7) ---
# Off by default: the system works on the deterministic Rules Engine alone.
AI_ENABLED=false
# Backend: "llama_cpp" (real, requires llama-cpp-python) or "fake" (offline/tests).
# Empty = auto (fake when OFFLINE_MODE, else llama_cpp).
AI_BACKEND=
# Path to a user-provided .gguf model. Never committed, never auto-downloaded.
AI_MODEL_PATH=
# Directory scanned for available .gguf models (portable: <root>/models).
MODELS_DIR=./models
# CPU threads for inference (2 is safe on a very weak machine).
AI_MODEL_THREADS=2
# Context window (tokens) — small keeps RAM low.
AI_CONTEXT_SIZE=2048
# Sampling temperature — low = more deterministic classification.
AI_TEMPERATURE=0.1
# Max tokens generated per classification (the JSON answer is tiny).
AI_MAX_TOKENS=128
# Hard timeout for one inference, in seconds.
AI_TIMEOUT_SECONDS=30
# Keep the model resident between calls (faster, uses RAM). Off by default.
AI_KEEP_LOADED=false
# Rules confidence at/above which the AI is not consulted (fast path).
AI_RULES_THRESHOLD=0.55
# AI confidence at/above which the AI result is accepted over rules.
AI_CONFIDENCE_THRESHOLD=0.6
# How many recent AI inference records to keep for diagnostics (0 = none).
AI_HISTORY_LIMIT=200

# --- Telegram Mini App ---
# Master switch. Off by default; the local Web UI is the primary interface.
MINIAPP_ENABLED=false
# Max age (seconds) of Telegram initData before it is rejected as stale.
MINIAPP_INITDATA_MAX_AGE=86400
# Lifetime (seconds) of a signed Mini App session cookie.
MINIAPP_SESSION_TTL=86400
# Public HTTPS URL the Mini App is served from (register it in BotFather).
MINIAPP_PUBLIC_URL=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Backup ---
BACKUP_DIR=./backups
# How many recent backups to keep; older ones are pruned (0 = keep all).
BACKUP_RETENTION=20
# Include MTProto session files in a backup. Off by default: session files grant
# full account access, so handle them separately.
BACKUP_INCLUDE_SESSIONS=false
